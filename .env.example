# =============================================================================
# phadewoman — environment variables
#
# Local dev:  copy this file to `.env.local` and fill in the values.
# Production: add each of these in Vercel -> Project -> Settings -> Environment
#             Variables, then redeploy.
# =============================================================================

# -----------------------------------------------------------------------------
# Admin login (REQUIRED)
#
# These are the credentials you use to sign in at /admin/login.
# Change them any time by editing the Vercel environment variables and
# redeploying — no database migration or code change needed.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=you@phadewoman.com
ADMIN_PASSWORD=change-me-to-something-long-and-random

# Signs the admin session cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Optional: how long an admin stays signed in, in hours (default 12).
# ADMIN_SESSION_HOURS=12

# -----------------------------------------------------------------------------
# Supabase (REQUIRED for products, orders, customers, inventory)
#
# Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The `service_role` secret — SERVER ONLY. Never prefix this with NEXT_PUBLIC_
# and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Paystack (OPTIONAL — needed for revenue tracking and payment sync)
#
# Dashboard -> Settings -> API Keys & Webhooks
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=

# -----------------------------------------------------------------------------
# AI description assistant — OpenAI (OPTIONAL)
#
# Get a key at https://platform.openai.com/api-keys. Without it, the
# "Write with AI" buttons are hidden and everything else works normally.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# Optional — which model writes the descriptions. Defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Messages from the shop front — Resend (OPTIONAL)
#
# Sends the "Here to help" form to the address in Settings -> Storefront.
# Get a key at https://resend.com/api-keys (it starts with `re_`).
# Without it the form still works: it hands the finished message to the
# shopper's own mail app instead, so nothing typed is ever lost.
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# Optional — the address the message is sent FROM. Defaults to
# onboarding@resend.dev, which works immediately but looks like a test.
# To use your own, verify the domain at https://resend.com/domains first;
# an unverified address is rejected and the form falls back to the mail app.
# CONTACT_FROM=shop@phadewoman.com

# -----------------------------------------------------------------------------
# Cart tracking (OPTIONAL — powers the Checkouts page)
#
# A shared secret the storefront sends as an `x-storefront-key` header when it
# POSTs cart changes to /api/cart. Leave this unset and the endpoint stays
# closed — nothing can write carts. Generate one with:  openssl rand -base64 32
# -----------------------------------------------------------------------------
STOREFRONT_API_KEY=
