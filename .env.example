# =============================================================================
# phadewoman — environment variables
#
# Local dev:  copy this file to `.env.local` and fill in the values.
# Production: add each of these in Vercel -> Project -> Settings -> Environment
#             Variables, then redeploy.
# =============================================================================

# -----------------------------------------------------------------------------
# Admin login (REQUIRED)
#
# These are the credentials you use to sign in at /admin/login.
# Change them any time by editing the Vercel environment variables and
# redeploying — no database migration or code change needed.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=you@phadewoman.com
ADMIN_PASSWORD=change-me-to-something-long-and-random

# Signs the admin session cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Optional: how long an admin stays signed in, in hours (default 12).
# ADMIN_SESSION_HOURS=12

# -----------------------------------------------------------------------------
# Supabase (REQUIRED for products, orders, customers, inventory)
#
# Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The `service_role` secret — SERVER ONLY. Never prefix this with NEXT_PUBLIC_
# and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Paystack (OPTIONAL — needed for revenue tracking and payment sync)
#
# Dashboard -> Settings -> API Keys & Webhooks
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=

# -----------------------------------------------------------------------------
# AI description assistant — OpenAI (OPTIONAL)
#
# Get a key at https://platform.openai.com/api-keys. Without it, the
# "Write with AI" buttons are hidden and everything else works normally.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# Optional — which model writes the descriptions. Defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Email — Resend (OPTIONAL, but strongly recommended)
#
# Sends three things:
#   1. the customer's receipt when an order is paid for,
#   2. your own new-order alert, to the address in Settings -> Developers
#      (or Settings -> Storefront if you leave that blank),
#   3. the "Here to help" contact form.
#
# Get a key at https://resend.com/api-keys (it starts with `re_`).
# Without it the contact form still works — it hands the finished message to
# the shopper's own mail app — but no order emails are sent at all.
#
# The wording of the order emails is edited in the dashboard, under
# Settings -> Developers -> Order emails, not here.
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# The address all of the above are sent FROM. Defaults to onboarding@resend.dev,
# which works immediately with no DNS setup but looks like a test address —
# fine for mail landing in your own inbox, wrong on a customer's receipt.
# Verify your domain at https://resend.com/domains first, then set an address
# on it here. An unverified address is rejected by Resend.
CONTACT_FROM=notifications@phadewoman.com

# Optional — where the links inside an email point. An email outlives the
# request that sent it, and the Paystack webhook arrives with no browser
# attached, so the site's own address can't always be worked out. Vercel's
# built-in variables cover a normal deployment; set this to be certain, and to
# stop preview deployments emailing links to themselves.
# NEXT_PUBLIC_SITE_URL=https://phadewoman.com

# -----------------------------------------------------------------------------
# Cart tracking (OPTIONAL — powers the Checkouts page)
#
# A shared secret the storefront sends as an `x-storefront-key` header when it
# POSTs cart changes to /api/cart. Leave this unset and the endpoint stays
# closed — nothing can write carts. Generate one with:  openssl rand -base64 32
# -----------------------------------------------------------------------------
STOREFRONT_API_KEY=
